# =============================================================================
#  EnterpriseAI — optionale Einstellungen  /  optional settings
# =============================================================================
#
#  DIESE DATEI WIRD NICHT BENÖTIGT. `docker compose up -d` läuft ohne sie.
#  Der Sicherheitsschlüssel wird beim ersten Start selbst erzeugt.
#
#  THIS FILE IS NOT REQUIRED. `docker compose up -d` works without it.
#  The security key is generated on first start.
#
#  Wer etwas ändern will, kopiert sie nach config/.env und setzt nur die
#  Zeilen, die er wirklich braucht. Alles andere hat sinnvolle Vorgaben.
#
#  Name, Betreiber, Farbe und Sprache stellt ein Administrator bequemer in der
#  Oberfläche ein (Administration → Unternehmen) — dafür ist hier nichts nötig.
# =============================================================================

# --- Netz / network ----------------------------------------------------------
#PORT=3001
#HOST=0.0.0.0

# HTTPS: 0 bedeutet aus. Zertifikat und Schlüssel liegen unter config/certs/.
#HTTPS_PORT=0
#TLS_CERT_PATH=./certs/cert.pem
#TLS_KEY_PATH=./certs/key.pem

# --- Sicherheit / security ---------------------------------------------------
# Wird beim ersten Start automatisch erzeugt. Nur setzen, wenn er aus einer
# anderen Installation übernommen werden soll — ein Wechsel meldet alle ab.
#JWT_SECRET=
#JWT_TTL=7d

# --- Sprachmodell / language model -------------------------------------------
# Zeigt auf Ollama. Im Container-Verbund ist der Dienst „ollama" erreichbar.
#OLLAMA_URL=http://ollama:11434
#OLLAMA_MODEL=gpt-oss:120b
#OLLAMA_EMBED_MODEL=bge-m3
#OLLAMA_NUM_CTX=65536
#OLLAMA_TEMPERATURE=0.3
# Denktiefe: off | low | medium | high
#OLLAMA_THINK=medium

# --- Active Directory (optional) ---------------------------------------------
# Leer lassen = ausschließlich lokale Benutzerkonten.
# Leave empty = local accounts only.
#AD_URL=ldaps://dc01.example.com:636
#AD_FALLBACK_URL=ldaps://dc02.example.com:636
#AD_BASE_DN=DC=example,DC=com
#AD_USER_SEARCH_BASE=OU=Benutzer,DC=example,DC=com
#AD_BIND_DN=CN=service-ki,OU=Dienste,DC=example,DC=com
#AD_BIND_PASSWORD=
# Nur Mitglieder dieser Gruppe dürfen sich anmelden. Leer = alle.
#AD_REQUIRED_GROUP=CN=KI-Nutzer,OU=Gruppen,DC=example,DC=com
#AD_TIMEOUT_MS=5000

# --- Ablage / storage --------------------------------------------------------
# Standard: config/data/app.db. Nur ändern, wenn die Datenbank woanders liegt.
#DATABASE_PATH=
